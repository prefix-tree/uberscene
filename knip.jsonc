{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  // Binaries the tests and scripts run from the system, not from node_modules.
  "ignoreBinaries": ["ffmpeg", "ffprobe"],
  // What a prepare script downloads to make an example's media (examples/interview/scripts/prepare.sh).
  "ignore": ["examples/*/.work/**"],
  "rules": { "exports": "error", "types": "error", "enumMembers": "error" },
  "workspaces": {
    ".": {
      // The playground's modules are imported from Playground.vue, and the gallery's data from Gallery.vue; knip does
      // not read .vue files.
      "entry": [
        "scripts/*.{ts,mjs}",
        "docs/gallery.data.ts",
        "docs/.vitepress/config.mts",
        "docs/.vitepress/theme/index.ts",
        "docs/.vitepress/theme/playground/mount.tsx",
        "docs/.vitepress/theme/playground/starters.ts",
        // A 3D scene in an edit: the video file, loaded by path like any cut file, and the scene file it plays, whose
        // exports the player reads as a module.
        "examples/3d/*.tsx",
        "examples/3d/*.scene.js",
        // The interview edit: its media is made by a script, so nothing imports the file.
        "examples/interview/*.tsx"
      ],
      // Run through its binary by scripts/check-packages.mjs.
      "ignoreDependencies": ["@arethetypeswrong/cli"]
    },
    "packages/kit": {
      "entry": ["scripts/*.ts"]
    },
    "packages/sdk": {
      "entry": ["scripts/*.ts", "fixtures/*.tsx"]
    },
    "packages/player": {
      "entry": ["e2e/**/*.{ts,tsx}"],
      // Loaded by fonts.css, which the package exports for the page to import.
      "ignoreDependencies": ["@fontsource/.+"]
    },
    "packages/render": {
      "entry": ["bench/**/*.{ts,tsx}", "scripts/*.{ts,mjs}"],
      // `uberscene matte` finds ONNX Runtime for the web on disk and serves it to its page; nothing imports it.
      "ignoreDependencies": ["onnxruntime-web"]
    },
    "packages/graphics": {
      "entry": ["test/**/*.{ts,tsx}"]
    },
    "packages/editor": {
      // The registry is the app's source: its `@/` imports resolve there, so the app's workspace checks it.
      "entry": ["scripts/*.ts"],
      "ignore": ["registry/**", "app/**"]
    },
    "packages/editor/app": {
      "entry": ["e2e/**/*.e2e.ts", "../registry/editor/*.{ts,tsx}"],
      // shadcn/ui components and their `cn`, kept as the CLI writes them; they export more than the editor uses.
      "ignore": ["src/components/ui/**", "src/lib/utils.ts"]
    },
    "examples/showcase": {
      // Cut files, loaded by path with loadVideo.
      "entry": [
        "*.ts",
        "*.tsx",
        "docs/*.tsx",
        "guide/*.tsx",
        "effects/*.tsx",
        "transitions/*.tsx",
        "components/*.tsx",
        "blocks/*.tsx",
        "motion/*.tsx"
      ]
    },
    "examples/shorts": {
      // Cut files, loaded by path with loadVideo; the blocks are copies whose meta and schema the CLI reads.
      "entry": ["*.tsx", "cards/*.tsx", "blocks/*.tsx", "test/**/*.ts"]
    },
    "examples/skill": {
      // The skill's examples: copied into its pages by scripts/gen-docs.ts and resolved by scripts/skill.test.ts.
      "entry": ["*.tsx"]
    },
    "examples/tiktok": {
      // Cut files, loaded by path with loadVideo from render.ts.
      "entry": ["*.tsx", "*.ts"]
    },
    "examples/orbit": {
      // A cut file, loaded by path; the scripts make its media and lightning.ts.
      "entry": ["video.tsx", "scripts/*.ts"]
    },
    "examples/liftoff": {
      // A cut file, loaded by path; the scripts make its media and ignitions.ts.
      "entry": ["video.tsx", "scripts/*.ts"]
    },
    "examples/founding": {
      // A cut file, loaded by path; media/bed.ts writes its music.
      "entry": ["*.tsx", "media/*.ts", "test/**/*.ts"]
    },
    "blocks": {
      // Each block's file is read by `uberscene blocks` and copied into projects; each demo is a cut file.
      "entry": ["*/block.tsx", "*/demo.tsx", "test/**/*.ts"]
    },
    "recipes": {
      "entry": ["*.tsx", "test/**/*.ts"]
    }
  }
}
